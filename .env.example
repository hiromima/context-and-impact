# context-and-impact — environment variables
# Copy this file: cp .env.example .env
# Then edit .env with your actual values.

# ── Required ──────────────────────────────────────────────────────────────────

# Root of your local dev workspace (default: ~/dev)
DEV_DIR=$HOME/dev

# Path to your Obsidian vault (for L2b / L3 layers)
# Leave blank to skip Obsidian-based layers
OBSIDIAN_DIR=$HOME/dev/content/obsidian

# ── Pipeline behaviour ─────────────────────────────────────────────────────────

# Override the context quality score (0–100).
# Useful when Context Engineering MCP is not running.
# QUALITY_SCORE=85

# Set to 1 to skip the quality gate and force-proceed even when score < 70.
# FORCE=0

# Set to 1 to show routing decisions without actually launching agents.
# DRY_RUN=0

# ── Optional integrations ──────────────────────────────────────────────────────

# GitHub token — needed for Copilot Coding Agent integration (Phase D)
# GITHUB_TOKEN=ghp_...

# Anthropic API key — needed if using Claude-based agents in Phase D
# ANTHROPIC_API_KEY=sk-ant-...
